<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.tiangong</groupId>
        <artifactId>tiangong-erp</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tiangong-server</artifactId>
    <description>天工 ERP · 启动器（聚合全部模块，唯一可执行 jar）</description>

    <dependencies>
        <!-- 已实现模块：M0 底座 -->
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-system</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-bas</artifactId>
        </dependency>
        <!-- M1 进销存闭环 -->
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-stk</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-pur</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-sal</artifactId>
        </dependency>
        <!-- M2 业务财务一体化 -->
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-fin</artifactId>
        </dependency>
        <!-- M3 生产制造 -->
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-mrp</artifactId>
        </dependency>
        <!-- M4 CRM / 人事 / 驾驶舱 -->
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-crm</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-hr</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-rpt</artifactId>
        </dependency>
        <!-- M5 审批 / 低代码表单 -->
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-bpm</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-infra</artifactId>
        </dependency>
        <!-- V12 文件传输 / IM 消息 -->
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-file</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.tiangong</groupId>
            <artifactId>tiangong-module-im</artifactId>
        </dependency>

        <!-- 数据库 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- API 文档 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
